; PICA200 vertex shader for BG tiles

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias  zeros myconst.xxxx ; Vector full of zeros
.alias  ones  myconst.yyyy ; Vector full of ones
; 1.0 / 32.0 ; 256 ; 160 + 40 + 8
.constf myconst2(0.03125, 256, 208, 8)
.alias TILE_TO_UV myconst2.xx
.alias BG_WRAPAROUND_OFFSET myconst2.y
.alias BG_WRAPAROUND_THRESHOLD myconst2.z
.alias BG_TILE_SIZE myconst2.w

; Outputs
.out out_pos position
.out out_uv texcoord0

; Inputs (defined as aliases for convenience)
.alias in_pos v0
.alias in_uv v1
; x = char slot of tile
.alias in_slot v2.x
.alias in_flip v3.xy
; xy = layer top-left
.alias in_layer_topleft v4.xy

.entry bg_main
.proc bg_main
	; let pos = &r0
	; pos.xy = in_pos.xy - in_layer_topleft.xy
	mov r0.xy, in_pos.xy
	add r0.xy, r0.xy, -in_layer_topleft.xy

	; Handle wraparound in the Y-down direction:
	; If tile Y is >= threshold then we move it up by the full height.
	mad r15.y, in_uv.y, BG_TILE_SIZE, r0.y
	sge r15.y, r15.y, BG_WRAPAROUND_THRESHOLD
	mad r0.y, r15.y, -BG_WRAPAROUND_OFFSET, r0.y

	; pos.zw = 1.0
	mov r0.zzzw, ones

	; out_pos = projectionMatrix * pos
	dp4 out_pos.x, projection[0], r0
	dp4 out_pos.y, projection[1], r0
	dp4 out_pos.z, projection[2], r0
	dp4 out_pos.w, projection[3], r0

	; --- Tile UV offset from char slot ---
	;
	; We need to compute:
	;  x = (in_slot % 32) / 32.0f;
	;  y = -(in_slot / 32) / 32.0f;
	; Which can be rewritten as:
	;  x = in_slot / 32.0f - floor(in_slot / 32.0f);
	;  y = -floor(in_slot / 32.0f) / 32.0f;
	; Actually x can be further simplified because UV wraps around:
	;  x = in_slot / 32.0f
	;
	; let char_tile = &r1
	; char_tile.xy =  (1.0 / 32.0) * in_slot
	mul r1.xy, TILE_TO_UV.xy, in_slot

	; char_tile.y = floor(char_tile.y)
	flr r1.y, r1.y

	; char_tile.y = -(1.0 / 32.0) * char_tile.y
	mul r1.y, TILE_TO_UV.y, -r1.y

	; --- Handle tile flip and scale base UV --
	;
	; let new_uv = &r2
	; new_uv.x = (in_flip.x == 1.0) ? (1.0 - in_uv.x) : in_uv.x
	; new_uv.y = (in_flip.y == 1.0) ? (-1.0 - in_uv.y) : in_uv.y
	cmp ones, eq, eq, in_flip.xy
	ifc cmp.x
		add r2.x, ones, -in_uv.x
	.else
		mov r2.x, in_uv.x
	.end
	ifc cmp.y
		add r2.y, -ones, -in_uv.y
	.else
		mov r2.y, in_uv.y
	.end

	; new_uv.xy *= (1.0 / 32.0)
	; NOTE: Fused with the next instruction.

	; --- Combine scaled UV and tile UV offset --

	; outuv.xy = new_uv.xy + char_tile.xy
	mad out_uv, r2.xy, TILE_TO_UV.xy, r1.xy

	; We're finished
	end
.end
