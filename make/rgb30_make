#!/usr/bin/env make

export CC ?= gcc
export AR ?= ar

export PLATFORM = rgb30

export PATH := $(PATH):tools

# Pre-compiler and Compiler flags
CXXFLAGS  := -Wall -O2 -Wno-array-bounds $(CXXFLAGS)
PRE_FLAGS := -MMD -MP -DRGB -DTE $(NO_DIAGNOSE)

# Project directory structure
BIN := bin/$(PLATFORM)
SRC := source
LIB := lib
INC := include
DATA := data
MUSIC := audio

# Build directories and output
TARGET := $(BIN)/Apotris
ASSETS_PATH := $(BIN)/assets
BINLIBS_PATH := $(BIN)/lib
BUILD := build/$(PLATFORM)

# Library search directories and flags
EXT_LIB := external/Tilengine/src/build/$(PLATFORM) external/soloud/lib/$(PLATFORM)
LDLIBS  := -lTilengine -lsoloud -lSDL2 -lSDL2_mixer -pthread
LDFLAGS := $(addprefix -L,$(BIN)/$(LIB) $(EXT_LIB)) $(LDFLAGS)

# Include directories
INC_DIRS := $(INC) $(shell find $(SRC) -type d) $(BUILD) $(DATA) external/soloud/include
INC_FLAGS := $(addprefix -I,$(INC_DIRS))

# Construct build output and dependency filenames
SRCS := $(shell find $(SRC) -name *.cpp)
BINFILES := $(shell find $(DATA) -name '*.bin')

OBJS_BIN := $(subst $(DATA)/,$(BUILD)/,$(addsuffix .o,$(BINFILES)))

OBJS_SOURCES := $(subst $(SRC)/,$(BUILD)/,$(addsuffix .o,$(basename $(SRCS))))

HFILES := $(subst $(DATA)/,$(BUILD)/,$(addsuffix .h,$(subst .,_,$(BINFILES))))

OBJS := $(OBJS_SOURCES) $(OBJS_BIN)

DEPS := $(OBJS:.o=.d)

AUDIO_FILES := $(shell find $(MUSIC) -name '*.*')

ICON_FILE := sprites/favicon32.bmp

ICON := $(addprefix $(ASSETS_PATH)/, $(notdir $(ICON_FILE)))

ASSETS := $(addprefix $(ASSETS_PATH)/, $(notdir $(AUDIO_FILES)))

LIBFILES := $(addprefix $(BINLIBS_PATH)/, $(notdir $(shell find $(LIB) -name '*.so')))

# Build task
build: all

# Main task

all: libTilengine.a libsoloud.a $(TARGET) $(ASSETS) $(ICON) $(LIBFILES)

libTilengine.a:
	@$(MAKE) -C external/Tilengine/src

libsoloud.a:
	@cd external/soloud && $(MAKE)

$(ICON) : $(ICON_FILE)

# Task producing target from built files
$(TARGET): $(OBJS) libsoloud.a libTilengine.a
	@echo "Building..."
	@mkdir -p $(dir $@)
	@$(CXX) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)

# Compile all cpp files
$(BUILD)/%.o: $(SRC)/%.cpp
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) $(PRE_FLAGS) $(INC_FLAGS) $(CPPFLAGS) -c -o $@ $<

$(BUILD)/%.bin.o $(BUILD)/%_bin.h : $(DATA)/%.bin
	@mkdir -p $(dir $@)
	@bin2s -a 4 -H `(echo $(BUILD)/$(<F) | tr . _)`.h $< | $(AS) -o $(BUILD)/$(<F).o

$(ASSETS_PATH)/% : $(MUSIC)/% external/bloom.glsl
	@mkdir -p $(dir $@)
	@cp -f $< $@

$(ICON) :
	@mkdir -p $(dir $@)
	@cp -f $< $@

$(BINLIBS_PATH)/% : $(LIB)/%
	@mkdir -p $(dir $@)
	@cp -f $< $@

$(OBJS_SOURCES) : $(HFILES)
# @echo "$<"

# Clean task
.PHONY: clean
clean:
	@echo "Cleaning..."
	rm -rf build/$(PLATFORM)
	cd external/Tilengine/src && make clean
	cd external/soloud && make clean

help:
	@echo "bin: $(LIBFILES)"

# Include all dependencies
-include $(DEPS)

